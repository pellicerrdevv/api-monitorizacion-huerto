{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Monitorización de un Huerto",
    "version": "1.0.0",
    "description": "API para la monitorización de un huerto mediante el uso de sensores y lecturas para analizar parámetros del huerto."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor local"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Registrar un nuevo usuario",
        "description": "Crea un usuario con rol 'user'. El rol no se puede elegir: si se envía, la petición se rechaza con 400.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado. Devuelve el token y el usuario.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (formato, contraseña débil o campos no permitidos como role)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "El email ya está registrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Iniciar sesión con un usuario existente",
        "description": "Comprueba las credenciales y devuelve un token JWT que tiene validez durante 8 horas",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inicio de sesión correcto. Devuelve el token y el usuario.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": {
            "description": "Datos inválidos: email con un formato incorrecto, contraseña vacía o JSON mal escrito",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas: email inexistente o contraseña incorrecta.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/sensors": {
      "get": {
        "tags": ["Sensores"],
        "summary": "Listar todos los sensores",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista completa de sensores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "count": { "type": "integer", "example": 3 },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Sensor" }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido/caducado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Sensores"],
        "summary": "Crear un nuevo sensor (solo el administrador es capaz de hacerlo)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSensorRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sensor creado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Sensor" }
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL del sensor creado",
                "schema": {
                  "type": "string",
                  "example": "/api/sensors/6adf1f1ceaf276071906db1c"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos: falta algún campo obligatorio, magnitud no permitida, threshold no numérico o campos no admitidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido/caducado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "El usuario no tiene permisos de administrador",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Ya existe un sensor con ese código",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/sensors/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "ID del sensor (ObjectId de MongoDB)",
          "schema": { "type": "string", "example": "6adfd819e7ae2cc2925f9451" }
        }
      ],
      "get": {
        "tags": ["Sensores"],
        "summary": "Obtener el detalle de un sensor",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Datos del sensor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Sensor" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "El id no tiene formato de ObjectId válido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido/caducado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No existe ningún sensor con ese id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Sensores"],
        "summary": "Modificar parcialmente un sensor (solo el administrador es capaz de hacerlo)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSensorRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sensor modificado. El sensor ya se devuelve actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Sensor" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos: id con un formato incorrecto, body vacío (hay que enviar al menos un campo), valores con un formato incorrecto o campos que no están admitidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido/caducado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "El usuario no tiene permisos de administrador para modificar un sensor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No existe ningún sensor con ese id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "El nuevo código ya está siendo usado por otro sensor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Sensores"],
        "summary": "Eiminar un sensor(solo es capaz de hacerlo el administrador)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": {
            "description": "Sensor eliminado correctamente. No devuelve contenido"
          },
          "400": {
            "description": "El id no tiene formato de ObjectId válido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido/caducado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "El usuario no tiene permisos de administrador para eliminar un sensor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No existe ningún sensor con ese id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "El sensor tiene lecturas ya registradas y no se puede eliminar. El sensor tiene que desactivarse con isActive = false",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/sensors/{sensorId}/readings": {
      "parameters": [
        {
          "name": "sensorId",
          "in": "path",
          "required": true,
          "description": "ID del sensor (ObjectId)",
          "schema": { "type": "string", "example": "6adfd819e7ae2cc2925f9451" }
        }
      ],
      "post": {
        "tags": ["Lecturas"],
        "summary": "Registrar una lectura de un sensor (cualquier usuario autenticado)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateReadingRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lectura registrada. isAnomalous lo calcula el servidor comparando value con el threshold del sensor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Reading" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos: value no numérico, id con formato incorrecto o campos no admitidos, como isAnomalous",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido/caducado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "No existe ningún sensor con ese id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "El sensor está inactivo y no admite lecturas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": {
            "description": "La unidad no coincide con la del sensor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/readings": {
      "get": {
        "tags": ["Lecturas"],
        "summary": "Consultar el histórico de lecturas (paginado, filtrable y ordenable)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Número de página",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "magnitude",
            "in": "query",
            "required": false,
            "description": "Filtrar por magnitud del sensor",
            "schema": {
              "type": "string",
              "enum": ["soil_moisture", "temperature", "light", "air_humidity"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Lecturas por página (máximo 50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "name": "sensor",
            "in": "query",
            "description": "ID del sensor(ObjectId)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "anomalous",
            "in": "query",
            "description": "true = solo anómalas, false = solo normales",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Campo de ordenación; el prefijo - indica que es de orden descendente",
            "schema": {
              "type": "string",
              "enum": ["measuredAt", "-measuredAt", "value", "-value"],
              "default": "-measuredAt"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de lecturas que cumplen los filtros, en el orden indicado, con los metadatos de paginación",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Reading" }
                    },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos: página no numérica, limit mayor que 50, magnitud o sort no permitidos...",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido/caducado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "fail" },
          "error": { "type": "string", "example": "ValidationError" },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "type": "object" } }
        }
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "6adf1f1ceaf276071906db1c" },
          "email": { "type": "string", "example": "ana@huerto.com" },
          "fullName": { "type": "string", "example": "Ana López" },
          "role": { "type": "string", "enum": ["user", "admin"] }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": {
            "type": "string",
            "example": "Operación realizada con éxito"
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCi6iKP..."
              },
              "user": { "$ref": "#/components/schemas/PublicUser" }
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "fullName"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@huerto.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo",
            "example": "Huerto2026!"
          },
          "fullName": {
            "type": "string",
            "minLength": 3,
            "example": "Ana López"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@huerto.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "Huerto2026!"
          }
        }
      },
      "CreateSensorRequest": {
        "type": "object",
        "required": ["code", "magnitude", "location", "threshold", "unit"],
        "properties": {
          "code": { "type": "string", "example": "HUM-02" },
          "magnitude": {
            "type": "string",
            "enum": ["soil_moisture", "temperature", "light", "air_humidity"],
            "example": "soil_moisture"
          },
          "location": { "type": "string", "example": "Solar 3 - Pimientos" },
          "isActive": { "type": "boolean", "example": true },
          "threshold": { "type": "number", "example": 30 },
          "unit": { "type": "string", "example": "%" }
        },
        "additionalProperties": false
      },
      "UpdateSensorRequest": {
        "type": "object",
        "minProperties": 1,
        "example": { "threshold": 25 },
        "properties": {
          "code": { "type": "string", "example": "HUM-02" },
          "magnitude": {
            "type": "string",
            "enum": ["soil_moisture", "temperature", "light", "air_humidity"],
            "example": "soil_moisture"
          },
          "location": { "type": "string", "example": "Solar 3 - Pimientos" },
          "isActive": { "type": "boolean", "example": true },
          "threshold": { "type": "number", "example": 30 },
          "unit": { "type": "string", "example": "%" }
        },
        "additionalProperties": false
      },
      "Sensor": {
        "type": "object",
        "required": ["code", "magnitude", "location", "threshold", "unit"],
        "properties": {
          "_id": { "type": "string", "example": "6adfd819e7ae2cc2925f9451" },
          "code": { "type": "string", "example": "HUM-02" },
          "magnitude": {
            "type": "string",
            "enum": ["soil_moisture", "temperature", "light", "air_humidity"],
            "example": "soil_moisture"
          },
          "location": { "type": "string", "example": "Parcela 3 - Pimientos" },
          "isActive": { "type": "boolean", "example": true },
          "threshold": { "type": "number", "example": 30 },
          "unit": { "type": "string", "example": "%" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "SensorSummary": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6adfd819e7ae2cc2925f9451" },
          "code": { "type": "string", "example": "HUM-01" },
          "magnitude": {
            "type": "string",
            "enum": ["soil_moisture", "temperature", "light", "air_humidity"],
            "example": "soil_moisture"
          },
          "location": { "type": "string", "example": "Parcela 3 - Pimientos" },
          "unit": { "type": "string", "example": "%" }
        }
      },
      "Reading": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6adfdf1ce7ae2cc2925f9453" },
          "sensor": {
            "description": "Al crear se devuelve el ObjectId del sensor; en el listado viene con sus datos (populate)",
            "oneOf": [
              { "type": "string", "example": "6adfd819e7ae2cc2925f9451" },
              { "$ref": "#/components/schemas/SensorSummary" }
            ]
          },
          "value": { "type": "number", "example": 45 },
          "unit": { "type": "string", "example": "%" },
          "measuredAt": { "type": "string", "format": "date-time" },
          "isAnomalous": {
            "type": "boolean",
            "example": true,
            "description": "Es calculado por el servidor: value > threshold del sensor"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateReadingRequest": {
        "type": "object",
        "required": ["value"],
        "description": "El cliente no puede enviar isAnomalous ya que es el servidor quien lo calcula",
        "example": { "value": 45 },
        "properties": {
          "value": { "type": "number", "example": 30 },
          "unit": { "type": "string", "example": "%" },
          "measuredAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "hasNextPage": { "type": "boolean" },
          "hasPrevPage": { "type": "boolean" },
          "next": {
            "type": "string",
            "nullable": true,
            "example": "?page=2&limit=2&magnitude=soil_moisture&sort=-measuredAt"
          },
          "prev": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
