# Vamos a ejecutar la aplicación en el puerto 3000
PORT=3000
# Fase actual del proyecto, que puede ser development, production o test
NODE_ENV=development
# URI de nuestra aplicación para conectarse a MongoDB Atlas, hay que sustituir usuario, password y cluster en sus respectivos apartados
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/huerto
# URI de la base de datos que usan los test automáticos pero que está separada de la real, porque los tests se vacían
MONGODB_URI_TEST=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/huerto_test
# Clave para que el servidor firme y compruebe los tokens
JWT_SECRET=aqui_va_una_clave_larga_y_aleatoria
# Validez de nuestro token
JWT_EXPIRATION_IS_IN=8h
# Email del administrador, que es el que se crea al arrancar si no existe
ADMIN_EMAIL=admin@porejemplo.com
# Contraseña del administrador
ADMIN_PASSWORD=contraseñacualquiera
